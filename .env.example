# Optional configuration for SignBridge AI.
#
# The pipeline reads paths from environment variables so the same code runs
# locally and on Kaggle without edits. Copy this file to `.env` if you prefer,
# or export the variables in your shell — nothing here is a secret.

# Project root. Only set this if you run the code from a different directory.
# SIGNBRIDGE_ROOT=C:/path/to/signbridge-ai

# Root of the extracted WLASL dataset. It must contain:
#   WLASL_v0.3.json
#   wlasl_class_list.txt
#   videos/
#
# Defaults to data/raw locally, and to the Kaggle input mount when /kaggle
# exists.
# WLASL_ROOT=C:/path/to/wlasl-processed